package PracticasFechas;

import java.time.LocalDate;
import java.time.format.DateTimeParseException;
import java.time.temporal.ChronoUnit;
import java.util.InputMismatchException;
import java.util.Scanner;

public class Ejercicio9_4 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner sc = new Scanner(System.in);
		LocalDate fecha = null ,fecha2 = null;
		int dia = 0, dia2 = 0,mes = 0,mes2 = 0 ,año = 0 ,año2 = 0;
		boolean correcta = false;
		do {
			try {
			System.out.println("Introduce día.");
			dia=sc.nextInt();
			System.out.println("Introduce mes");
			mes=sc.nextInt();
			System.out.println("Introduce año");
			año = sc.nextInt();
			}
			catch (InputMismatchException e) { //Deja el scanneer con un enter 
			//SOLO PASA CON ESTA EXCEPCION
				sc.nextLine();
				System.out.println("Esperaba un número");
				continue;
			}
			try {
				fecha = LocalDate.of(año, mes, dia);
				System.out.println("fecha leida:"+fecha);
				correcta = true;
			}
			catch(DateTimeParseException e) {
				System.out.println("Fecha Incorrecta");
			}
		} while(correcta);
		correcta = false;
		do {
			try {
			System.out.println("Introduce día.");
			dia2=sc.nextInt();
			System.out.println("Introduce mes");
			mes2=sc.nextInt();
			System.out.println("Introduce año");
			año2 = sc.nextInt();
			}
			catch (InputMismatchException e) { //Deja el scanneer con un enter 
			//SOLO PASA CON ESTA EXCEPCION
				sc.nextLine();
				System.out.println("Esperaba un número");
				continue;
			}
			try {
				fecha2 = LocalDate.of(año2, mes2, dia2);
				System.out.println("fecha leida:"+fecha2);
				correcta = true;
			}
			catch(DateTimeParseException e) {
				System.out.println("Fecha Incorrecta");
			}
		} while(correcta);
		long dias = ChronoUnit.DAYS.between(fecha, fecha2);
		System.out.println("Dias transcurridos "+dias);
		long meses = ChronoUnit.MONTHS.between(fecha, fecha2);
		System.out.println("Meses transcurridos: "+meses);
	}
}


